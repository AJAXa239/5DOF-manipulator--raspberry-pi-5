<?xml version="1.0"?>
<robot name="robotic_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       GLOBAL PROPERTIES
       STL meshes are modelled in MILLIMETERS, ROS works in METERS,
       so every mesh is scaled by 0.001. Each part is also authored
       Y-up in its own local frame, so links get a rotation to stand
       up along +Z (ROS convention).
       ============================================================ -->
  <xacro:property name="mesh_path" value="package://robotic_arm_description/meshes"/>
  <xacro:property name="scale"     value="0.001 0.001 0.001"/>

  <!-- servo visual macros (servo_mg995 / servo_sg90) -->
  <xacro:include filename="servos.xacro"/>

  <!-- ros2_control inclusion -->
  <xacro:include filename="robotic_arm.ros2_control.xacro"/>
  <xacro:robotic_arm_ros2_control name="robotic_arm" initial_positions_file="$(find robotic_arm_description)/config/initial_positions.yaml"/>

  <!-- ===== Materials ===== -->
  <material name="red">   <color rgba="0.80 0.10 0.10 1.0"/></material>
  <material name="white"> <color rgba="0.90 0.90 0.90 1.0"/></material>
  <material name="grey">  <color rgba="0.50 0.50 0.50 1.0"/></material>
  <material name="servo_blue"><color rgba="0.10 0.20 0.75 1.0"/></material>

  <!-- ============================================================
       WORLD  ->  base_link  (fixed pedestal)
       ============================================================ -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- base_link : the white cylindrical base.
       Mesh is 121 x 56 x 121 mm, Y-up in its own frame.
       rpy="1.5708 0 0"  -> maps mesh +Y (height) to world +Z (up).
       xyz offset re-centres the mesh on the Z axis and sits its
       bottom face on z=0. -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.0606 0.0606 0.0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/Base.STL" scale="${scale}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <!-- J1 actuator: MG995 (metal gear). Shaft on the +Z waist-yaw axis.
         Seated DOWN inside the base cavity; shaft reaches the rim (z=0.056)
         where the waist mounts, so it sits enclosed instead of hovering. -->
    <xacro:servo_mg995 xyz="0 0 0.013" rpy="0 0 0"/>

    <collision>
      <origin xyz="-0.0606 0.0606 0.0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/Base.STL" scale="${scale}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.028" rpy="0 0 0"/>
      <mass value="0.5"/>
      <!-- placeholder inertia; meshes aren't watertight so we set these
           manually. Refined per-link later. -->
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Next step: Waist link + joint_1 (base yaw about Z) -->

  <!-- ============================================================
       joint_1  :  base yaw (revolute about +Z, driven by the MG995)
       waist_link : the red rotating yoke that carries the arm
       ============================================================ -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child  link="waist_link"/>
    <origin xyz="0 0 0.056" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Servo channel 10: home 110°, safe physical range 0°-180° -> RViz -110° to +70° -->
    <limit lower="-1.9199" upper="1.2217" effort="10.0" velocity="3.14"/>
  </joint>

  <link name="waist_link">
    <visual>
      <origin xyz="-0.0485 0.0485 0.0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/Waist.STL" scale="${scale}"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="-0.0485 0.0485 0.0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/Waist.STL" scale="${scale}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- Shoulder servo block (visual only) as its own link so it renders black,
       fixed to the waist. Same raw-frame visual transform as the waist mesh. -->
  <joint name="waist_to_shoulder_servo" type="fixed">
    <parent link="waist_link"/>
    <child  link="shoulder_servo_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="shoulder_servo_link">
    <visual>
      <origin xyz="-0.0485 0.0485 0.0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/Shoulder_Block.STL" scale="${scale}"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
  </link>

  <!-- Next step: Arm_01 link + joint_2 (shoulder pitch) -->

  <!-- ============================================================
       joint_2  :  shoulder pitch (revolute about +X at the shoulder hole)
       arm_01_link : the upper arm; points up (+Z) at joint_2 = 0
       ============================================================ -->
  <joint name="joint_2" type="revolute">
    <parent link="waist_link"/>
    <child  link="arm_01_link"/>
    <origin xyz="0.008 0.0139 0.0403" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- Servo channel 11: home 110°, safe physical range 0°-180° -> RViz -110° to +70° -->
    <limit lower="-1.9199" upper="1.2217" effort="12.0" velocity="3.14"/>
  </joint>

  <link name="arm_01_link">
    <visual>
      <!-- Arm_01 authored Z-up-hole, Y-long. Rotate so pivot(Zarm)->X,
           long axis(Yarm)->+Z; translate shoulder hole to the origin. -->
      <origin xyz="-0.00935 -0.0306 -0.0261" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="${mesh_path}/Arm_01.STL" scale="${scale}"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="-0.00935 -0.0306 -0.0261" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="${mesh_path}/Arm_01.STL" scale="${scale}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- Next step: Arm_02 link + joint_3 (elbow pitch) -->

  <!-- ============================================================
       joint_3  :  elbow pitch (revolute about +X at Arm_01's elbow hole)
       arm_02_link : the forearm; continues up (+Z) at joint_3 = 0
       (origin on -X side + ~180 deg yaw flip so it seats on the correct
        side and faces the right way)
       ============================================================ -->
  <joint name="joint_3" type="revolute">
    <parent link="arm_01_link"/>
    <child  link="arm_02_link"/>
    <origin xyz="-0.0164 0.0005 0.1195" rpy="0 0 3.125"/>
    <axis xyz="1 0 0"/>
    <!-- Servo channel 12: home 10°, safe physical range 0°-180° -> RViz -10° to +170° -->
    <limit lower="-0.1745" upper="2.9671" effort="10.0" velocity="3.14"/>
  </joint>

  <link name="arm_02_link">
    <visual>
      <origin xyz="-0.008 -0.0193 -0.0249" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="${mesh_path}/Arm_02_v3.STL" scale="${scale}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="-0.008 -0.0193 -0.0249" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="${mesh_path}/Arm_02_v3.STL" scale="${scale}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.00015"/>
    </inertial>
  </link>

  <!-- Elbow servo block (visual only) as its own link so it renders black,
       fixed to the forearm. Same raw-frame visual transform as Arm_02. -->
  <joint name="arm02_to_elbow_servo" type="fixed">
    <parent link="arm_02_link"/>
    <child  link="elbow_servo_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="elbow_servo_link">
    <visual>
      <origin xyz="-0.008 -0.0193 -0.0249" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="${mesh_path}/Elbow_Servo.STL" scale="${scale}"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
  </link>

  <!-- Next step: Arm_03 link + joint_4 (wrist) -->

  <!-- ============================================================
       joint_4  :  wrist pitch (revolute) at the forearm's distal hole.
       Arm_03 placed from the reference assembly via registration; mesh
       already baked into the arm_03_link frame (meters, pivot at origin).
       ============================================================ -->
  <joint name="joint_4" type="revolute">
    <parent link="arm_02_link"/>
    <child  link="arm_03_link"/>
    <origin xyz="0.0045 -0.0049 0.1219" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Servo channel 13: home 110°, safe physical range 0°-180° -> RViz -110° to +70° -->
    <limit lower="-1.9199" upper="1.2217" effort="6.0" velocity="3.14"/>
  </joint>

  <link name="arm_03_link">
    <visual>
      <origin xyz="0.0003 0.005 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/Arm_03_placed.STL" scale="1 1 1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.0003 0.005 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/Arm_03_placed.STL" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Next step: gripper -->

  <!-- Wrist SG90 servo (visual only) from the reference assembly, seated in
       the forearm's distal pocket, fixed to the forearm. Own link -> black. -->
  <joint name="arm02_to_wrist_servo" type="fixed">
    <parent link="arm_02_link"/>
    <child  link="wrist_servo_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wrist_servo_link">
    <visual>
      <origin xyz="-0.008 -0.0193 -0.0249" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="${mesh_path}/Wrist_Servo.STL" scale="${scale}"/>
      </geometry>
      <material name="servo_blue"/>
    </visual>
  </link>

  <!-- SG90 servo seated inside Arm_03 (drives the next joint), fixed to Arm_03.
       Mesh already baked into arm_03_link frame (meters). Own link -> black. -->
  <joint name="arm03_to_servo" type="fixed">
    <parent link="arm_03_link"/>
    <child  link="arm03_servo_link"/>
    <origin xyz="0.0003 0.005 0" rpy="0 0 0"/>
  </joint>

  <link name="arm03_servo_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/Arm03_Servo.STL" scale="1 1 1"/>
      </geometry>
      <material name="servo_blue"/>
    </visual>
  </link>

  <!-- Gripper base on Arm_03. joint_5 revolute so the gripper base can move.
       Position (xyz) is a starting point — nudge to seat it on Arm_03. -->
  <joint name="joint_5" type="revolute">
    <parent link="arm_03_link"/>
    <child  link="gripper_base_link"/>
    <origin xyz="-0.0183 -0.0024 0.002" rpy="0 0 0.2"/>
    <axis xyz="1 0 0"/>
    <!-- Servo channel 14: home 100°, physical range 57°-143° -> RViz -43° to +43° -->
    <limit lower="-0.7505" upper="0.7505" effort="4.0" velocity="3.14"/>
  </joint>

  <link name="gripper_base_link">
    <visual>
      <origin xyz="-0.01 -0.014 -0.014" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/Gripper_base.STL" scale="${scale}"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <!-- Gripper SG90 servo on the gripper base (drives the claws). FIRST-GUESS
       placement, fixed — position/orientation to be dialed in. -->
  <joint name="gripper_base_to_servo" type="fixed">
    <parent link="gripper_base_link"/>
    <child  link="gripper_servo_link"/>
    <origin xyz="0.017 -0.015 0.038" rpy="4.7 4.7 0"/>
  </joint>

  <link name="gripper_servo_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/ServoSG90.stl" scale="${scale}"/>
      </geometry>
      <material name="servo_blue"/>
    </visual>
  </link>

  <!-- Gear on the gripper servo shaft (joint_6, driven by the servo). It moves
       the gripper linkage. Seated coaxial with the SG90 output shaft. -->
  <joint name="joint_6" type="revolute">
    <parent link="gripper_base_link"/>
    <child  link="gear_link"/>
    <origin xyz="0.0231 0.0169 0.0381" rpy="4.7 4.7 0"/>
    <axis xyz="0 0 1"/>
    <!-- Servo channel 15 gripper: home 90°, physical range 57°-143° -> RViz -33° to +53° -->
    <limit lower="-1.5" upper="0.9250" effort="2.0" velocity="3.14"/>
  </joint>

  <link name="gear_link">
    <visual>
      <origin xyz="0 0 -0.002" rpy="0 0 2"/>
      <geometry>
        <mesh filename="${mesh_path}/gear_new.stl" scale="${scale}"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- gear2 on a pin in the gripper base, meshing with gear1. It mimics
       joint_6 with multiplier -1, so it always turns opposite gear1. -->
  <joint name="joint_7" type="revolute">
    <parent link="gripper_base_link"/>
    <child  link="gear2_link"/>
    <origin xyz="-0.001 0.0169 0.0381" rpy="4.7 4.7 0"/>
    <axis xyz="0 0 1"/>
    <!-- Mimics joint_6 with multiplier -1, so joint_6 -33°..+53° becomes joint_7 -53°..+33°. -->
    <limit lower="-0.9250" upper="0.5670" effort="2.0" velocity="3.14"/>
    <mimic joint="joint_6" multiplier="-1" offset="0"/>
  </joint>

  <link name="gear2_link">
    <visual>
      <origin xyz="0 0 -0.002" rpy="0 0 1.2"/>
      <geometry>
        <mesh filename="${mesh_path}/gear_new.stl" scale="${scale}"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- Two grip links pinned to the gripper base holes (part of the 4-bar that
       keeps the claws parallel). FIRST-GUESS placement, fixed for now. -->

  <!-- Gripper claw: hole B (bottom tab, 67.3,6.5mm) bolts to gear arm-end pin.
       Teeth point outward. Moves with joint_6 via gear_link. -->

  <!-- Second claw on gear2, mirrored so claws face each other -->

</robot>
